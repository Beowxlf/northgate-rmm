#!/bin/sh
set -eu

case "${1:-}" in
  configure)
    ;;
  *)
    exit 0
    ;;
esac
previous_version="${2:-}"

if ! getent group northgate-rmm >/dev/null; then
  addgroup --system --quiet northgate-rmm
fi
if ! getent passwd northgate-rmm >/dev/null; then
  adduser --system --quiet --ingroup northgate-rmm --home /var/lib/northgate-rmm \
    --no-create-home --shell /usr/sbin/nologin --disabled-password northgate-rmm
fi

account="$(getent passwd northgate-rmm)"
group="$(getent group northgate-rmm)"
case "$account" in
  northgate-rmm:*:/var/lib/northgate-rmm:/usr/sbin/nologin)
    ;;
  *)
    echo "northgate-rmm account differs from package policy" >&2
    exit 41
    ;;
esac
case "$group" in
  northgate-rmm:*)
    ;;
  *)
    echo "northgate-rmm group differs from package policy" >&2
    exit 42
    ;;
esac

account_uid="$(printf '%s\n' "$account" | cut -d: -f3)"
account_gid="$(printf '%s\n' "$account" | cut -d: -f4)"
group_gid="$(printf '%s\n' "$group" | cut -d: -f3)"
case "$account_uid:$account_gid:$group_gid" in
  *[!0-9:]*|*::*|:*)
    echo "northgate-rmm account has invalid numeric identity fields" >&2
    exit 45
    ;;
esac
if [ "$account_uid" -eq 0 ] || [ "$account_uid" -ge 1000 ] || [ "$account_gid" -ne "$group_gid" ]; then
  echo "northgate-rmm account is not the dedicated package system identity" >&2
  exit 46
fi
set -- $(id -Gn northgate-rmm)
if [ "$#" -ne 1 ] || [ "$1" != "northgate-rmm" ]; then
  echo "northgate-rmm account has unexpected supplementary group access" >&2
  exit 47
fi

install -d -o root -g root -m 0755 /etc/northgate-rmm
install -d -o northgate-rmm -g northgate-rmm -m 0700 /var/lib/northgate-rmm
# Any configure/upgrade starts a new lifecycle generation. Revocation,
# evidence-export, and purge approval must all be established again afterward.
rm -f -- /etc/northgate-rmm/.identity-revoked \
  /etc/northgate-rmm/.evidence-exported \
  /etc/northgate-rmm/.purge-approved
if [ -f /etc/northgate-rmm/agent.json ]; then
  chown root:northgate-rmm /etc/northgate-rmm/agent.json
  chmod 0640 /etc/northgate-rmm/agent.json
fi

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  if [ -n "$previous_version" ] && [ -f /run/northgate-rmm-agent.was-active ]; then
    systemctl start northgate-rmm-agent.service
    if ! systemctl is-active --quiet northgate-rmm-agent.service; then
      echo "agent service did not become active after upgrade" >&2
      exit 56
    fi
    rm -f /run/northgate-rmm-agent.was-active
  elif [ -z "$previous_version" ]; then
    rm -f -- /run/northgate-rmm-agent.was-active
    if ! systemctl disable northgate-rmm-agent.service >/dev/null; then
      echo "agent service could not be left disabled" >&2
      exit 54
    fi
    if [ "$(systemctl is-enabled northgate-rmm-agent.service 2>/dev/null || true)" != "disabled" ]; then
      echo "agent service did not reach the required disabled state" >&2
      exit 55
    fi
  fi
fi

exit 0
