#!/bin/sh
set -eu

action="${1:-}"
if [ "$action" = "purge" ]; then
  if [ -e /var/lib/northgate-rmm/identity/identity.json ]; then
    echo "refusing purge while endpoint identity remains" >&2
    exit 40
  fi
  approval=/etc/northgate-rmm/.purge-approved
  evidence=/etc/northgate-rmm/.evidence-exported
  revocation=/etc/northgate-rmm/.identity-revoked
  if [ ! -f "$approval" ] || [ ! -f "$evidence" ] || \
     [ ! -f "$revocation" ] || [ -L "$revocation" ] || [ ! -s "$revocation" ] || \
     [ "$(stat -c '%U:%G:%a' "$approval")" != "root:root:600" ] || \
     [ "$(stat -c '%U:%G:%a' "$evidence")" != "root:root:600" ] || \
     [ "$(stat -c '%U:%G:%a' "$revocation")" != "root:root:600" ]; then
    echo "refusing purge without revocation, approval, and evidence-export receipts" >&2
    exit 43
  fi
  rm -rf -- /var/lib/northgate-rmm
  test ! -e /var/lib/northgate-rmm
  if getent passwd northgate-rmm >/dev/null; then
    deluser --quiet northgate-rmm
  fi
  if getent passwd northgate-rmm >/dev/null; then
    echo "service account remains after purge deletion" >&2
    exit 48
  fi
  if getent group northgate-rmm >/dev/null; then
    delgroup --quiet northgate-rmm
  fi
  if getent group northgate-rmm >/dev/null; then
    echo "service group remains after purge deletion" >&2
    exit 49
  fi
  rm -rf -- /etc/northgate-rmm
  test ! -e /etc/northgate-rmm
fi

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
fi

exit 0
