#!/bin/sh
set -eu

action="${1:-}"
if [ "$action" = "purge" ]; then
  if [ -e /var/lib/northgate-rmm/identity/identity.json ]; then
    echo "refusing purge while endpoint identity remains" >&2
    exit 40
  fi
  approval=/etc/northgate-rmm/.purge-approved
  evidence=/etc/northgate-rmm/.evidence-exported
  revocation=/etc/northgate-rmm/.identity-revoked
  transaction=/var/lib/northgate-rmm-purge-transaction
  expected_transaction=northgate-rmm-purge-transaction-v1:authorized
  if [ -e "$transaction" ]; then
    if [ ! -f "$transaction" ] || [ -L "$transaction" ] || \
       [ "$(stat -c '%U:%G:%a' "$transaction")" != "root:root:600" ] || \
       [ "$(cat "$transaction")" != "$expected_transaction" ]; then
      echo "refusing purge with an invalid recovery transaction" >&2
      exit 63
    fi
  else
    if [ ! -f "$approval" ] || [ ! -f "$evidence" ] || \
       [ ! -f "$revocation" ] || [ -L "$revocation" ] || [ ! -s "$revocation" ] || \
       [ "$(stat -c '%U:%G:%a' "$approval")" != "root:root:600" ] || \
       [ "$(stat -c '%U:%G:%a' "$evidence")" != "root:root:600" ] || \
       [ "$(stat -c '%U:%G:%a' "$revocation")" != "root:root:600" ]; then
      echo "refusing purge without revocation, approval, and evidence-export receipts" >&2
      exit 43
    fi
    transaction_temp="${transaction}.tmp"
    rm -f -- "$transaction_temp"
    install -o root -g root -m 0600 /dev/null "$transaction_temp"
    printf '%s\n' "$expected_transaction" > "$transaction_temp"
    sync -f "$transaction_temp"
    mv -f -- "$transaction_temp" "$transaction"
    sync -f /var/lib
  fi
  rm -rf -- /var/lib/northgate-rmm
  test ! -e /var/lib/northgate-rmm
  if getent passwd northgate-rmm >/dev/null; then
    deluser --quiet northgate-rmm
  fi
  if getent passwd northgate-rmm >/dev/null; then
    echo "service account remains after purge deletion" >&2
    exit 48
  fi
  if getent group northgate-rmm >/dev/null; then
    delgroup --quiet northgate-rmm
  fi
  if getent group northgate-rmm >/dev/null; then
    echo "service group remains after purge deletion" >&2
    exit 49
  fi
fi

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
fi

if [ "$action" = "remove" ] || [ "$action" = "purge" ]; then
  rm -f -- /run/northgate-rmm-agent.was-active \
    /run/northgate-rmm-agent.remove-state-recorded \
    /run/northgate-rmm-agent.was-active-remove \
    /run/northgate-rmm-agent.was-enabled-remove
fi
if [ "$action" = "purge" ]; then
  if [ -L /etc/northgate-rmm ]; then
    echo "refusing endpoint purge through a symlinked configuration path" >&2
    exit 64
  fi
  rm -f -- \
    /etc/northgate-rmm/agent.json \
    /etc/northgate-rmm/.identity-revoked \
    /etc/northgate-rmm/.evidence-exported \
    /etc/northgate-rmm/.purge-approved
  rmdir -- /etc/northgate-rmm 2>/dev/null || true
fi

exit 0
