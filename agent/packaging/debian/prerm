#!/bin/sh
set -eu

action="${1:-}"
if [ "$action" = "remove" ]; then
  if [ -e /var/lib/northgate-rmm/identity/identity.json ]; then
    echo "refusing removal while endpoint identity remains" >&2
    exit 40
  fi
  revocation=/etc/northgate-rmm/.identity-revoked
  if [ ! -f "$revocation" ] || [ -L "$revocation" ] || [ ! -s "$revocation" ] || \
     [ "$(stat -c '%U:%G:%a' "$revocation")" != "root:root:600" ]; then
    echo "refusing removal without a root-controlled revocation receipt" >&2
    exit 44
  fi
fi

if [ -d /run/systemd/system ]; then
  if [ "$action" = "upgrade" ] && systemctl is-active --quiet northgate-rmm-agent.service; then
    : > /run/northgate-rmm-agent.was-active
  fi
  systemctl stop northgate-rmm-agent.service >/dev/null 2>&1 || true
  if [ "$action" = "remove" ]; then
    systemctl disable northgate-rmm-agent.service >/dev/null 2>&1 || true
  fi
fi

exit 0
