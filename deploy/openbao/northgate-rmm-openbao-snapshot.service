[Unit]
Description=Fresh encrypted OpenBao snapshot for NorthGate operations backup
After=network-online.target openbao.service
Requires=openbao.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/northgate-rmm-openbao/operations-snapshot.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/openbao-maintenance /etc/northgate-rmm
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=300
MemoryMax=256M
CPUQuota=20%
TasksMax=16
Nice=10
IOSchedulingClass=idle
