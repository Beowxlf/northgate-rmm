[Unit]
Description=Deliver NorthGate RMM audit outbox
After=network-online.target
[Service]
Type=oneshot
User=northgate-rmm-export
Group=northgate-rmm-export
UMask=0077
LoadCredential=client-key:/etc/northgate-rmm/secrets/export-key.pem
LoadCredential=database-dsn:/etc/northgate-rmm/secrets/export-dsn
ExecStart=/usr/libexec/northgate-rmm-server/northgate-rmm-audit-export --config /etc/northgate-rmm/audit-export.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=600
MemoryMax=256M
