[Unit]
Description=NorthGate RMM private audit workload
Documentation=https://github.com/Beowxlf/northgate-rmm
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=northgate-rmm-audit
Group=northgate-rmm-audit
UMask=0077
LoadCredential=server-key:/etc/northgate-rmm/tls/audit-key.pem
LoadCredential=checkpoint-key:/etc/northgate-rmm/secrets/audit-checkpoint-key.pem
StateDirectory=northgate-rmm-server/audit
StateDirectoryMode=0700
MemoryMax=256M
TasksMax=32
LimitNOFILE=128
ExecStart=/opt/northgate-rmm/venv/bin/northgate-rmm-audit-service --config /etc/northgate-rmm/audit-service.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=45s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/northgate-rmm-checkpoints
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
KeyringMode=private

[Install]
WantedBy=multi-user.target
