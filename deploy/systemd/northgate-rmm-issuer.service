[Unit]
Description=NorthGate RMM private issuer workload
Documentation=https://github.com/Beowxlf/northgate-rmm
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=northgate-rmm-issuer
Group=northgate-rmm-issuer
UMask=0077
LoadCredential=server-key:/etc/northgate-rmm/tls/issuer-key.pem
LoadCredential=issuer-key:/etc/northgate-rmm/secrets/endpoint-issuer-key.pem
LoadCredential=issuer-chain:/etc/northgate-rmm/secrets/endpoint-issuer-chain.pem
StateDirectory=northgate-rmm-server/issuer
StateDirectoryMode=0700
MemoryMax=256M
TasksMax=32
LimitNOFILE=128
ExecStart=/opt/northgate-rmm/venv/bin/northgate-rmm-issuer-service --config /etc/northgate-rmm/issuer-service.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=45s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
KeyringMode=private

[Install]
WantedBy=multi-user.target
