[Unit]
Description=NorthGate operations and device-workspace encrypted backup
After=network-online.target

[Service]
Type=oneshot
User=northgate-rmm-operator
Group=northgate-rmm-operator
UMask=0077
LoadCredential=database-dsn:/etc/northgate-rmm/secrets/backup-dsn
LoadCredential=manifest-key:/etc/northgate-rmm/secrets/backup-signing.pem
LoadCredential=remote-key:/etc/northgate-rmm/secrets/remote-json-key
LoadCredential=remote-credentials:/etc/northgate-rmm/secrets/remote-credentials.aes
ExecStart=/opt/northgate-rmm/venv/bin/python -m northgate_rmm.operations_backup --config /etc/northgate-rmm/operations-backup.json backup-auto /var/backups/northgate-rmm-operations
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/var/lib/northgate-rmm-remote
ReadWritePaths=/var/backups/northgate-rmm-operations
TimeoutStartSec=3600
MemoryMax=256M
Nice=10
IOSchedulingClass=idle
