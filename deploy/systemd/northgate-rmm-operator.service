[Unit]
Description=NorthGate RMM private read-only operator service
Documentation=https://github.com/Beowxlf/northgate-rmm
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=northgate-rmm-operator
Group=northgate-rmm-operator
UMask=0077
LoadCredential=database-dsn:/etc/northgate-rmm/secrets/operator-database-dsn
LoadCredential=verifier-client-cert:/etc/northgate-rmm/secrets/verifier-client.crt
LoadCredential=verifier-client-key:/etc/northgate-rmm/secrets/verifier-client.key
ExecStart=/opt/northgate-rmm/venv/bin/northgate-rmm-operator-service --config /etc/northgate-rmm/operator-service.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=45s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
KeyringMode=private

[Install]
WantedBy=multi-user.target
