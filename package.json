{
  "name": "northgate-rmm-repository-tools",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Governance and audit tooling for the NorthGate RMM repository",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:governance": "node scripts/audit-governance.mjs && node scripts/test-v1d-authority.mjs && node scripts/test-cms-verification.mjs",
    "audit:workflows": "node scripts/audit-workflows.mjs",
    "audit:secrets-lite": "node scripts/audit-secrets-lite.mjs",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.tools\" \"#.venv\" \"#.pytest_cache\" \"#.mypy_cache\" \"#.ruff_cache\"",
    "format:check": "prettier --check \".github/**/*.md\" \".github/**/*.{yml,yaml}\" \"docs/**/*.md\" \"governance/**/*.json\" \"scripts/**/*.mjs\" \"*.md\" package.json .markdownlint-cli2.jsonc --ignore-path .prettierignore",
    "format:write": "prettier --write \".github/**/*.md\" \".github/**/*.{yml,yaml}\" \"docs/**/*.md\" \"governance/**/*.json\" \"scripts/**/*.mjs\" \"*.md\" package.json .markdownlint-cli2.jsonc --ignore-path .prettierignore",
    "audit:pre-code": "npm run audit:governance && npm run audit:workflows && npm run audit:secrets-lite && npm run lint:markdown && npm run format:check",
    "gate:g1": "node scripts/check-gate.mjs G1"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "js-yaml": "5.2.2",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  }
}
